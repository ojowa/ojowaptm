{
  "expo": {
    "name": "ojowaPTM",
    "slug": "ojowaPTM",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ojowaPTM needs access to your microphone to stream audio to OBS over WiFi.",
        "NSLocalNetworkUsageDescription": "ojowaPTM needs local network access to stream to OBS on WiFi."
      }
    },
    "android": {
      "package": "com.ojowacam.ojowaPTM",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-av"
    ]
  }
}
