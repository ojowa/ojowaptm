<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ojowaPTM OBS Microphone Plugin" Language="1033" Version="1.0.0" Manufacturer="ojowa" UpgradeCode="a1b2c3d4-e5f6-7890-abcd-ef1234567890"><SummaryInformation Description="ojowaPTM OBS Microphone Plugin MSI" Manufacturer="ojowa" />

    <MajorUpgrade AllowDowngrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="PluginFeature" Title="ojowaPTM Plugin" Level="1">
      <ComponentGroupRef Id="PluginComponents" />
    </Feature>

    

    <ComponentGroup Id="PluginComponents">
      <ComponentRef Id="PluginDllComponent" />
    </ComponentGroup>

  
      <StandardDirectory Id="ProgramFilesFolder">
        <Directory Id="OBSFolder" Name="obs-studio">
          <Directory Id="PluginsFolder" Name="obs-plugins">
            <Directory Id="INSTALLDIR" Name="ojowaptm-obs">
              <Component Id="PluginDllComponent" Guid="b2c3d4e5-f6a7-8901-bcde-f23456789012">
                <File Id="ojowaptmPluginDll" Name="ojowaptm-obs.dll" Source="obs-plugin/build/Release/ojowaptm-obs.dll" KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </StandardDirectory>
    </Package>
</Wix>